#: argparse.py:227
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s："

#: argparse.py:300
msgid "usage: "
msgstr "用法："

#: argparse.py:704
#, python-format
msgid " (default: %(default)s)"
msgstr "（默认：%(default)s）"

#: argparse.py:766
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "参数 %(argument_name)s: %(message)s"

#: argparse.py:875
msgid ".__call__() not defined"
msgstr ".__call__() 未定义"

#: argparse.py:1166
msgid "show program's version number and exit"
msgstr "显示程序的版本号并退出"

#: argparse.py:1229
#, python-format
msgid "conflicting subparser: %s"
msgstr "冲突的子解析器：%s"

#: argparse.py:1233
#, python-format
msgid "conflicting subparser alias: %s"
msgstr "冲突的子解析器别名：%s"

#: argparse.py:1272
#, python-format
msgid "unknown parser %(parser_name)r (choices: %(choices)s)"
msgstr "未知的解析器 %(parser_name)r（选择：%(choices)s）"

#: argparse.py:1276
#, python-format
msgid "command '%(parser_name)s' is deprecated"
msgstr "命令“%(parser_name)s”已被弃用"

#: argparse.py:1337
#, python-format
msgid "argument \"-\" with mode %r"
msgstr "%r 模式的参数 \"-\""

#: argparse.py:1346
#, python-format
msgid "can't open '%(filename)s': %(error)s"
msgstr "无法打开“%(filename)s”：%(error)s"

#: argparse.py:1560
#, python-format
msgid "cannot merge actions - two groups are named %r"
msgstr "无法合并动作——两个组都被命名为 %r"

#: argparse.py:1602
msgid "'required' is an invalid argument for positionals"
msgstr "'required' 对于位置参数无效"

#: argparse.py:1623
#, python-format
msgid "invalid option string %(option)r: must start with a character %(prefix_chars)r"
msgstr "无效的选项字符串 %(option)r：必须以字符 %(prefix_chars)r 开头"

#: argparse.py:1641
#, python-format
msgid "dest= is required for options like %r"
msgstr "类似 %r 的选项必须指定 dest="

#: argparse.py:1658
#, python-format
msgid "invalid conflict_resolution value: %r"
msgstr "无效的 conflict_resolution 值：%r"

#: argparse.py:1676
#, python-format
msgid "conflicting option string: %s"
msgid_plural "conflicting option strings: %s"
msgstr[0] "冲突的选项字符串：%s"

#: argparse.py:1751
msgid "mutually exclusive arguments must be optional"
msgstr "互斥参数必须是可选的"

#: argparse.py:1828
msgid "positional arguments"
msgstr "位置参数"

#: argparse.py:1829
msgid "options"
msgstr "选项"

#: argparse.py:1844
msgid "show this help message and exit"
msgstr "显示该帮助信息并退出"

#: argparse.py:1875
msgid "cannot have multiple subparser arguments"
msgstr "不能有多个子解析器参数"

#: argparse.py:1881
msgid "subcommands"
msgstr "子命令"

#: argparse.py:1928 argparse.py:2491
#, python-format
msgid "unrecognized arguments: %s"
msgstr "不认识的参数：%s"

#: argparse.py:2034
#, python-format
msgid "not allowed with argument %s"
msgstr "不可与 %s 参数搭配使用"

#: argparse.py:2053
#, python-format
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "选项存在歧义：%(option)s 可能匹配上 %(matches)s"

#: argparse.py:2085 argparse.py:2117
#, python-format
msgid "ignored explicit argument %r"
msgstr "忽略了显式参数 %r"

#: argparse.py:2137
#, python-format
msgid "option '%(option)s' is deprecated"
msgstr "选项“%(option)s”已被弃用"

#: argparse.py:2169
#, python-format
msgid "argument '%(argument_name)s' is deprecated"
msgstr "参数“%(argument_name)s”已被弃用"

#: argparse.py:2262
#, python-format
msgid "the following arguments are required: %s"
msgstr "必须传入以下参数：%s"

#: argparse.py:2277
#, python-format
msgid "one of the arguments %s is required"
msgstr "必须传入 %s 其中之一"

#: argparse.py:2321
msgid "expected one argument"
msgstr "预期单个参数"

#: argparse.py:2322
msgid "expected at most one argument"
msgstr "预期至多一个参数"

#: argparse.py:2323
msgid "expected at least one argument"
msgstr "预期至少一个参数"

#: argparse.py:2327
#, python-format
msgid "expected %s argument"
msgid_plural "expected %s arguments"
msgstr[0] "预期 %s 个参数"

#: argparse.py:2437
#, python-format
msgid "unexpected option string: %s"
msgstr "非预期的选项字符串：%s"

#: argparse.py:2574
#, python-format
msgid "%r is not callable"
msgstr "%r 不可调用"

#: argparse.py:2590
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "无效的 %(type)s 值：%(value)r"

#: argparse.py:2605
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "无效的选择：%(value)r（从 %(choices)s 中选择）"

#: argparse.py:2686
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s：错误：%(message)s\n"

#: argparse.py:2690
#, python-format
msgid "%(prog)s: warning: %(message)s\n"
msgstr "%(prog)s：警告：%(message)s\n"

#~ msgid "invalid choice: %(value)r, maybe you meant %(closest)r? (choose from %(choices)s)"
#~ msgstr "无效的选择：%(value)r，您可能想的是 %(closest)r？（从 %(choices)s 中选择）"

